# .env.local olarak kopyalayıp değerleri doldurun. Hiçbiri NEXT_PUBLIC_ önekli değildir:
# hepsi yalnızca sunucuda okunur ve tarayıcıya gönderilmez.

# --- Supabase (zorunlu) ---
SUPABASE_URL=https://<proje-id>.supabase.co
SUPABASE_ANON_KEY=<anon-veya-publishable-key>

# --- Online ödeme (isteğe bağlı) ---
# Aşağıdakilerin HEPSİ doluysa sipariş sonrası müşteri iyzico ödeme sayfasına yönlendirilir.
# Boşsa siparişler "ödeme bekleniyor" olarak alınır.
#
# Supabase > Project Settings > API Keys > "secret" (veya eski adıyla service_role) anahtarı.
# TÜM YETKİLERE SAHİPTİR: asla paylaşmayın, GitHub'a göndermeyin.
SUPABASE_SECRET_KEY=
# iyzico > Ayarlar > Firma Ayarları > API anahtarları
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Sitenin herkese açık adresi (iyzico dönüş adresi için). Yerelde boş bırakılabilir.
SITE_URL=
